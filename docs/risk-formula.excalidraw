    {"id":"src2t","type":"text","x":505,"y":295,"width":410,"height":170,"angle":0,"strokeColor":"#7048e8","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":15,"version":1,"versionNonce":15,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":14,"fontFamily":2,"text":"ИСТОЧНИК\n\nxlsx ФСТЭК БДУ —\n3 булевых колонки:\n  • Нарушение конфиденциальности (C)\n  • Нарушение целостности (I)\n  • Нарушение доступности (A)\n\nСчитаем сколько true (0..3).","textAlign":"left","verticalAlign":"top","containerId":"src2","originalText":"ИСТОЧНИК\n\nxlsx ФСТЭК БДУ —\n3 булевых колонки:\n  • Нарушение конфиденциальности (C)\n  • Нарушение целостности (I)\n  • Нарушение доступности (A)\n\nСчитаем сколько true (0..3).","lineHeight":1.25},

