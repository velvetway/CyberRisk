    {"id":"stor2t","type":"text","x":505,"y":745,"width":410,"height":160,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":31,"version":1,"versionNonce":31,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":14,"fontFamily":2,"text":"ХРАНИТСЯ\nthreats.q_severity NUMERIC(3,2)\n\nРАСПРЕДЕЛЕНИЕ В БАЗЕ:\n  0.50  —  88 угроз  (1 из C/I/A)\n  0.70  —  54 угрозы (2 из 3)\n  0.90  —  85 угроз  (все 3)\n\n0.30 нет в базе: все импортированные\nугрозы нарушают хотя бы 1 из C/I/A.","textAlign":"left","verticalAlign":"top","containerId":"stor2","originalText":"ХРАНИТСЯ\nthreats.q_severity NUMERIC(3,2)\n\nРАСПРЕДЕЛЕНИЕ В БАЗЕ:\n  0.50  —  88 угроз  (1 из C/I/A)\n  0.70  —  54 угрозы (2 из 3)\n  0.90  —  85 угроз  (все 3)\n\n0.30 нет в базе: все импортированные\nугрозы нарушают хотя бы 1 из C/I/A.","lineHeight":1.25},

