    {"id":"src3t","type":"text","x":955,"y":295,"width":510,"height":170,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":17,"version":1,"versionNonce":17,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":14,"fontFamily":2,"text":"ИСТОЧНИК (вычисляется на лету)\n\nSQL-JOIN трёх таблиц:\n  • threat_vulnerable_links — какие VL у угрозы\n  • vl_category_controls — что закрывает каждую VL\n  • asset_controls — что внедрено на этом активе\n\nЗапрос в risk_graph_repository.go.","textAlign":"left","verticalAlign":"top","containerId":"src3","originalText":"ИСТОЧНИК (вычисляется на лету)\n\nSQL-JOIN трёх таблиц:\n  • threat_vulnerable_links — какие VL у угрозы\n  • vl_category_controls — что закрывает каждую VL\n  • asset_controls — что внедрено на этом активе\n\nЗапрос в risk_graph_repository.go.","lineHeight":1.25},

