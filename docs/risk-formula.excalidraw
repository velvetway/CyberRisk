    {"id":"stor3t","type":"text","x":955,"y":745,"width":510,"height":160,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":33,"version":1,"versionNonce":33,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":13,"fontFamily":2,"text":"НЕ ХРАНИТСЯ — пересчёт на каждый запрос риска.\n\nВОЗМОЖНЫЕ значения = { 0/n, 1/n, …, n/n },\nгде n — число VL, связанных с угрозой:\n   n=1 :  { 0, 1 }\n   n=2 :  { 0, 0.5, 1 }\n   n=3 :  { 0, 0.33, 0.67, 1 }\n   n=4 :  { 0, 0.25, 0.5, 0.75, 1 }\n   n=5 :  { 0, 0.2, 0.4, 0.6, 0.8, 1 }\n   n=6 :  { 0, 0.17, 0.33, 0.5, 0.67, 0.83, 1 }","textAlign":"left","verticalAlign":"top","containerId":"stor3","originalText":"НЕ ХРАНИТСЯ — пересчёт на каждый запрос риска.\n\nВОЗМОЖНЫЕ значения = { 0/n, 1/n, …, n/n },\nгде n — число VL, связанных с угрозой:\n   n=1 :  { 0, 1 }\n   n=2 :  { 0, 0.5, 1 }\n   n=3 :  { 0, 0.33, 0.67, 1 }\n   n=4 :  { 0, 0.25, 0.5, 0.75, 1 }\n   n=5 :  { 0, 0.2, 0.4, 0.6, 0.8, 1 }\n   n=6 :  { 0, 0.17, 0.33, 0.5, 0.67, 0.83, 1 }","lineHeight":1.25},

    {"id":"stor4","type":"rectangle","x":1490,"y":730,"width":410,"height":190,"angle":0,"strokeColor":"#868e96","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":34,"version":1,"versionNonce":34,"isDeleted":false,"boundElements":[{"type":"text","id":"stor4t"}],"updated":1700000000,"link":null,"locked":false},
    {"id":"stor4t","type":"text","x":1505,"y":745,"width":380,"height":160,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":35,"version":1,"versionNonce":35,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":14,"fontFamily":2,"text":"ХРАНИТСЯ\nassets.is_isolated BOOLEAN\n\nВСЕГДА 2 значения:\n  0.5\n  1.0\n\nИзменяется на форме редактирования\nактива (галочка «Изолированный»).","textAlign":"left","verticalAlign":"top","containerId":"stor4","originalText":"ХРАНИТСЯ\nassets.is_isolated BOOLEAN\n\nВСЕГДА 2 значения:\n  0.5\n  1.0\n\nИзменяется на форме редактирования\nактива (галочка «Изолированный»).","lineHeight":1.25},

    {"id":"matrixhead","type":"text","x":40,"y":950,"width":1860,"height":40,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":36,"version":1,"versionNonce":36,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":18,"fontFamily":2,"text":"Матрица VL ↔ control (для расчёта Q^реакция; берётся из дипломной таблицы 4.png; в БД vl_category_controls.coverage = 1.0)","textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"Матрица VL ↔ control (для расчёта Q^реакция; берётся из дипломной таблицы 4.png; в БД vl_category_controls.coverage = 1.0)","lineHeight":1.25},

    {"id":"matrix","type":"rectangle","x":40,"y":1000,"width":1860,"height":230,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"#ebfbee","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":37,"version":1,"versionNonce":37,"isDeleted":false,"boundElements":[{"type":"text","id":"matrixt"}],"updated":1700000000,"link":null,"locked":false},
    {"id":"matrixt","type":"text","x":60,"y":1015,"width":1820,"height":200,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":38,"version":1,"versionNonce":38,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":15,"fontFamily":2,"text":"VL₁  Нештатное доп. ПО                       →  A (Антивирус), AD (Администрирование), L (Защита от НСД)\nVL₂  Устаревшие версии ПО                  →  A, AD, L\nVL₃  Недекларируемое ПО                    →  A, AD, L\nVL₄  Обход правил администратором     →  AD, L\nVL₅  Носители (USB, диски)                   →  A, AD, L\nVL₆  Открытые ОС / нет защиты ЛВС     →  FW, HP, DZ, IDS, TE, DD","textAlign":"left","verticalAlign":"top","containerId":"matrix","originalText":"VL₁  Нештатное доп. ПО                       →  A (Антивирус), AD (Администрирование), L (Защита от НСД)\nVL₂  Устаревшие версии ПО                  →  A, AD, L\nVL₃  Недекларируемое ПО                    →  A, AD, L\nVL₄  Обход правил администратором     →  AD, L\nVL₅  Носители (USB, диски)                   →  A, AD, L\nVL₆  Открытые ОС / нет защиты ЛВС     →  FW, HP, DZ, IDS, TE, DD","lineHeight":1.25},

    {"id":"examplehead","type":"text","x":40,"y":1260,"width":1860,"height":40,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":39,"version":1,"versionNonce":39,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":18,"fontFamily":2,"text":"Полный проход формулы на live-данных","textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"Полный проход формулы на live-данных","lineHeight":1.25},

    {"id":"example","type":"rectangle","x":40,"y":1310,"width":1860,"height":420,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#fff9db","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":40,"version":1,"versionNonce":40,"isDeleted":false,"boundElements":[{"type":"text","id":"examplet"}],"updated":1700000000,"link":null,"locked":false},
    {"id":"examplet","type":"text","x":60,"y":1325,"width":1820,"height":390,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":41,"version":1,"versionNonce":41,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":15,"fontFamily":2,"text":"Актив:  Customer Database  (asset_id=2,  is_isolated=false)\nВнедрённые контроли:  Антивирус, Honeypot, Демилитаризованная зона, DDoS-фильтры\nУгроза:  УБИ.064 «Несанкционированный доступ к АРМ»\n\nQ^угроза = 0.6\n   ← в БДУ «Возможности нарушителя» = средние, маппинг → threats.q_threat = 0.6\n\nq^серьёзность = 0.7\n   ← в БДУ нарушает C+I, без A (2 из 3), маппинг → threats.q_severity = 0.7\n\nQ^реакция:\n   у угрозы 4 связанных VL: VL₁, VL₂, VL₃, VL₄\n   VL₁ закрывается {A, AD, L}  → внедрён А → закрыта ✓\n   VL₂ закрывается {A, AD, L}  → внедрён А → закрыта ✓\n   VL₃ закрывается {A, AD, L}  → внедрён А → закрыта ✓\n   VL₄ закрывается {AD, L}     → ничего не внедрено → НЕ закрыта ✗\n   Q^реакция = 3 / 4 = 0.75\n\nZ = 1.0   ← assets.is_isolated = false\n\nW = ( 0.6 + 0.7 + ( 1 − 0.75 ) ) / 3 · 1.0 = 1.55 / 3 = 0.52   →  УРОВЕНЬ: high","textAlign":"left","verticalAlign":"top","containerId":"example","originalText":"Актив:  Customer Database  (asset_id=2,  is_isolated=false)\nВнедрённые контроли:  Антивирус, Honeypot, Демилитаризованная зона, DDoS-фильтры\nУгроза:  УБИ.064 «Несанкционированный доступ к АРМ»\n\nQ^угроза = 0.6\n   ← в БДУ «Возможности нарушителя» = средние, маппинг → threats.q_threat = 0.6\n\nq^серьёзность = 0.7\n   ← в БДУ нарушает C+I, без A (2 из 3), маппинг → threats.q_severity = 0.7\n\nQ^реакция:\n   у угрозы 4 связанных VL: VL₁, VL₂, VL₃, VL₄\n   VL₁ закрывается {A, AD, L}  → внедрён А → закрыта ✓\n   VL₂ закрывается {A, AD, L}  → внедрён А → закрыта ✓\n   VL₃ закрывается {A, AD, L}  → внедрён А → закрыта ✓\n   VL₄ закрывается {AD, L}     → ничего не внедрено → НЕ закрыта ✗\n   Q^реакция = 3 / 4 = 0.75\n\nZ = 1.0   ← assets.is_isolated = false\n\nW = ( 0.6 + 0.7 + ( 1 − 0.75 ) ) / 3 · 1.0 = 1.55 / 3 = 0.52   →  УРОВЕНЬ: high","lineHeight":1.25},

    {"id":"limitshead","type":"text","x":40,"y":1760,"width":1860,"height":40,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":42,"version":1,"versionNonce":42,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":18,"fontFamily":2,"text":"Граничные значения и уровни риска","textAlign":"center","verticalAlign":"middle","containerId":null,"originalText":"Граничные значения и уровни риска","lineHeight":1.25},

    {"id":"limmin","type":"rectangle","x":40,"y":1810,"width":600,"height":140,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"#d3f9d8","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":43,"version":1,"versionNonce":43,"isDeleted":false,"boundElements":[{"type":"text","id":"limmint"}],"updated":1700000000,"link":null,"locked":false},
    {"id":"limmint","type":"text","x":55,"y":1825,"width":570,"height":110,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":44,"version":1,"versionNonce":44,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":15,"fontFamily":2,"text":"МИНИМУМ\n\nQ^угр=0.3, q^сер=0.5, Q^реак=1.0, Z=0.5\n\nW = ( 0.3 + 0.5 + 0 ) / 3 · 0.5 = 0.13   →  low","textAlign":"left","verticalAlign":"top","containerId":"limmin","originalText":"МИНИМУМ\n\nQ^угр=0.3, q^сер=0.5, Q^реак=1.0, Z=0.5\n\nW = ( 0.3 + 0.5 + 0 ) / 3 · 0.5 = 0.13   →  low","lineHeight":1.25},

    {"id":"limmax","type":"rectangle","x":660,"y":1810,"width":600,"height":140,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"#ffc9c9","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":45,"version":1,"versionNonce":45,"isDeleted":false,"boundElements":[{"type":"text","id":"limmaxt"}],"updated":1700000000,"link":null,"locked":false},
    {"id":"limmaxt","type":"text","x":675,"y":1825,"width":570,"height":110,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":46,"version":1,"versionNonce":46,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":15,"fontFamily":2,"text":"МАКСИМУМ\n\nQ^угр=0.9, q^сер=0.9, Q^реак=0, Z=1.0\n\nW = ( 0.9 + 0.9 + 1 ) / 3 · 1.0 = 0.93   →  critical","textAlign":"left","verticalAlign":"top","containerId":"limmax","originalText":"МАКСИМУМ\n\nQ^угр=0.9, q^сер=0.9, Q^реак=0, Z=1.0\n\nW = ( 0.9 + 0.9 + 1 ) / 3 · 1.0 = 0.93   →  critical","lineHeight":1.25},

    {"id":"levels","type":"rectangle","x":1280,"y":1810,"width":620,"height":140,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":{"type":3},"seed":47,"version":1,"versionNonce":47,"isDeleted":false,"boundElements":[{"type":"text","id":"levelst"}],"updated":1700000000,"link":null,"locked":false},
    {"id":"levelst","type":"text","x":1295,"y":1825,"width":590,"height":110,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":48,"version":1,"versionNonce":48,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":15,"fontFamily":2,"text":"УРОВНИ — LevelFromW (calculator_v2.go)\n\n  W ≥ 0.75  →  critical\n  W ≥ 0.50  →  high\n  W ≥ 0.25  →  medium\n  W <  0.25  →  low","textAlign":"left","verticalAlign":"top","containerId":"levels","originalText":"УРОВНИ — LevelFromW (calculator_v2.go)\n\n  W ≥ 0.75  →  critical\n  W ≥ 0.50  →  high\n  W ≥ 0.25  →  medium\n  W <  0.25  →  low","lineHeight":1.25}
