    {"id":"fboxt","type":"text","x":1220,"y":205,"width":620,"height":80,"angle":0,"strokeColor":"#c92a2a","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":28,"version":1,"versionNonce":28,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":22,"fontFamily":2,"text":"     Q^угроза + q^серьёзность + (1 − Q^реакция)\nW = ─────────────────────────────────────────── · Z\n                            3","textAlign":"center","verticalAlign":"middle","containerId":"fbox","originalText":"     Q^угроза + q^серьёзность + (1 − Q^реакция)\nW = ─────────────────────────────────────────── · Z\n                            3","lineHeight":1.25},

    {"id":"vars","type":"text","x":1210,"y":320,"width":640,"height":260,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":29,"version":1,"versionNonce":29,"isDeleted":false,"boundElements":null,"updated":1700000000,"link":null,"locked":false,"fontSize":15,"fontFamily":2,"text":"Q^угроза  ∈ [0..1]   степень реализации угрозы\n                     → threats.q_threat (из БДУ)\n\nq^серьёзность ∈ [0..1]   степень опасности угрозы\n                     → threats.q_severity (из БДУ)\n\nQ^реакция ∈ [0..1]   степень предотвращения\n                     = |VL, закрытые внедрёнными контролями| /\n                       |VL, связанные с угрозой|\n\nZ ∈ {0.5, 1.0}   коэф. критичности контура\n                     0.5 если актив изолирован (один контур),\n                     1.0 если доступен в обоих контурах","textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Q^угроза  ∈ [0..1]   степень реализации угрозы\n                     → threats.q_threat (из БДУ)\n\nq^серьёзность ∈ [0..1]   степень опасности угрозы\n                     → threats.q_severity (из БДУ)\n\nQ^реакция ∈ [0..1]   степень предотвращения\n                     = |VL, закрытые внедрёнными контролями| /\n                       |VL, связанные с угрозой|\n\nZ ∈ {0.5, 1.0}   коэф. критичности контура\n                     0.5 если актив изолирован (один контур),\n                     1.0 если доступен в обоих контурах","lineHeight":1.25},

